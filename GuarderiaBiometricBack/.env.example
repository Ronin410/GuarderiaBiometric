# Copia este archivo a .env y completa los valores reales. Nunca commitees el .env real.

# Credenciales AWS (Rekognition + S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Clave secreta usada para firmar los JWT. Genera una cadena aleatoria larga,
# por ejemplo con: openssl rand -base64 48
JWT_SECRET=

# Cadenas de conexión a PostgreSQL
DATABASE_URL=postgres://usuario:password@host:5432/db_operativa
DATABASE_URL_AUTH=postgres://usuario:password@host:5432/db_auth

# Orígenes permitidos por CORS, separados por comas (sin espacios extra).
# En producción, usa los dominios reales del frontend.
ALLOWED_ORIGINS=https://tu-frontend.example.com

# Notificaciones push (Web Push, gratis, sin servicio de terceros). Opcionales:
# si no se configuran, el servidor arranca igual y simplemente no envía push.
# Genera el par de claves una sola vez, por ejemplo con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tuguarderia.example.com

# Pagos en línea de colegiatura (Stripe Checkout). Opcionales: sin
# STRIPE_SECRET_KEY el servidor arranca igual y la función queda
# deshabilitada por completo (no aparece ningún botón de pago en línea).
# Para activarla hace falta también dar de alta un webhook en el dashboard
# de Stripe -> POST /webhooks/stripe, evento checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mxn
FRONTEND_URL=https://tu-frontend.example.com

# Llave compartida para revisar/aprobar solicitudes de alta de guardería
# nueva (POST /solicitudes-guarderia es público -- cualquiera puede pedir una
# guardería; estas rutas son las que de verdad la crean). Opcional: vacía
# deja /plataforma/solicitudes deshabilitado (404). Genera algo largo y
# aleatorio, ej. con: openssl rand -hex 32
PLATFORM_ADMIN_KEY=

# Chat de soporte con IA (RAG): antes de avisarle al dueño de la plataforma,
# el asistente intenta contestar solo con la documentación de los manuales
# de usuario como contexto (ver internal/server/ia_soporte.go). Opcionales:
# sin las dos, el chat de soporte se comporta exactamente igual que sin esta
# función. Requiere además que Postgres tenga pgvector disponible y haber
# corrido cmd/ingest-conocimiento al menos una vez -- ver README.md.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
