# URL base del backend. Copia este archivo a .env (o .env.local) y ajusta el valor.
# Desarrollo local:
# VITE_API_URL=https://localhost:8099
# Producción:
VITE_API_URL=https://guarderiabiometricback.onrender.com

# Clave PÚBLICA de VAPID para notificaciones push (debe ser la misma
# VAPID_PUBLIC_KEY configurada en el backend). Es pública a propósito, sirve
# solo para que el navegador verifique al servidor, no es un secreto.
VITE_VAPID_PUBLIC_KEY=
