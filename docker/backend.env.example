# Copia este archivo a docker/backend.env (docker compose lo toma solo si
# existe con ese nombre, ver docker-compose.yml) y ajusta lo que necesites.
# backend.env NO se sube a git.

# --- AWS (Rekognition + S3) --------------------------------------------------
# Con "dummy" el backend arranca y TODO lo que no dependa de Rekognition/S3
# funciona normal (login, paneles de admin, bitácora, pagos, reportes, ARCO).
# Lo único que falla es lo que sí llama a AWS de verdad: enrolar/identificar
# un rostro en el kiosco (POST /registrar, /identificar) y subir/ver fotos de
# la bitácora — fallan con un error controlado, no tumban el servidor.
#
# Para probar eso con Rekognition real, reemplaza estas tres líneas con
# credenciales de una cuenta de AWS de verdad (con permisos de Rekognition y
# S3) y con el bucket "biosafe-storage-fotos" ya creado en esa región y con
# "Block all public access" activado (ver GuarderiaBiometricBack/README.md).
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_REGION=us-east-1

# --- Auth ---------------------------------------------------------------------
# Clave de desarrollo — para producción usa una generada con
# `openssl rand -base64 48`, nunca esta.
JWT_SECRET=clave-de-desarrollo-solo-para-docker-local-no-usar-en-produccion

# --- Postgres -------------------------------------------------------------------
# "postgres" (el nombre del servicio en docker-compose.yml), no 127.0.0.1:
# a diferencia de un pod de Podman (que comparte "localhost" entre
# contenedores), en Docker Compose cada contenedor tiene su propia red y se
# habla con los demás por el nombre del servicio — Compose resuelve ese
# nombre solo, vía su DNS interno.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/guarderia?sslmode=disable
DATABASE_URL_AUTH=postgres://postgres:postgres@postgres:5432/guarderia?sslmode=disable

# --- CORS -------------------------------------------------------------------------
# Debe ser el origen EXACTO desde el que el navegador abre el frontend — la
# cookie de sesión es SameSite=None, y eso exige coincidencia exacta, no "*".
ALLOWED_ORIGINS=http://localhost:5173

# --- TLS ------------------------------------------------------------------------
# No hace falta poner nada aquí: la imagen del backend ya trae un
# certificado autofirmado horneado (ver GuarderiaBiometricBack/Dockerfile) y
# TLS_CERT_FILE/TLS_KEY_FILE con sus valores por defecto. Descomenta estas
# dos líneas solo si quieres usar un certificado propio en vez del generado
# en el build.
# TLS_CERT_FILE=/ruta/dentro/del/contenedor/cert.pem
# TLS_KEY_FILE=/ruta/dentro/del/contenedor/key.pem

# --- Push (opcional) --------------------------------------------------------------
# Vacías: el servidor arranca igual, solo no manda notificaciones push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.com

# --- Plataforma (revisar/aprobar solicitudes de guardería nueva) ----------------
# Con un valor puesto, ya puedes probar /plataforma en el frontend local.
# Cámbiala por algo aleatorio tuyo (ej. openssl rand -hex 32) antes de
# desplegar esto donde alguien más pueda verla -- esta llave de ejemplo NO es
# segura, solo sirve para desarrollo local.
PLATFORM_ADMIN_KEY=dev-platform-key
